# Ollama settings
OLLAMA_HOST=http://localhost:11434
EMBEDDING_MODEL=nomic-embed-text
DEFAULT_CHAT_MODEL=phi4-mini:3.8b

# LLM generation (8GB CPU-only defaults)
NUM_CTX=2048
NUM_PREDICT=512
OLLAMA_KEEP_ALIVE=30m
LLM_TEMPERATURE=0.1

# Server
RELOAD=false

# Vector DB settings
VECTORDB_PATH=data/vectors

# RAG chunking
CHUNK_SIZE=1500
CHUNK_OVERLAP=200

# RAG retrieval
RETRIEVAL_K=5
RETRIEVAL_FETCH_K=20
RETRIEVAL_MAX_CHUNKS=5
ENABLE_HYBRID_SEARCH=false
HYBRID_VECTOR_WEIGHT=0.7
USE_MMR=true
USE_MULTI_QUERY=false

# OCR fallback for scanned PDFs
ENABLE_OCR_FALLBACK=true
OCR_MIN_CHARS=50

# Logging
LOG_LEVEL=INFO

# Stage 4: Groq Cloud API & Provider Routing
# Execution modes: "normal" (Ollama -> Groq), "presentation" (Groq -> Ollama), "offline" (Ollama only)
RAG_MODE=normal
OLLAMA_FALLBACK_TIMEOUT=60.0

# Groq Cloud settings (API key kept exclusively in backend environment)
# GROQ_API_KEY=gsk_your_api_key_here
GROQ_MODEL=openai/gpt-oss-20b
GROQ_API_BASE=https://api.groq.com/openai/v1
GROQ_TIMEOUT_SECONDS=30.0
GROQ_MAX_TOKENS=512
GROQ_TEMPERATURE=0.1

